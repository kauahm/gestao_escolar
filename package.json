{
  "name": "gestao-escolar-hortolandia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "dev:emulador": "vite --mode emulador",
    "emulador": "npx -y firebase-tools@13 emulators:start --only auth,firestore --project demo-gestao-escolar",
    "emulador:dados": "node scripts/semear-emulador.mjs",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "node --test tests/importacao/*.test.mjs tests/interface/*.test.mjs",
    "test:regras": "npx -y firebase-tools@13 emulators:exec --only firestore --project demo-gestao-escolar \"node --test tests/regras/*.test.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "firebase": "^10.14.1",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.14.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "vite": "^5.2.0"
  }
}
