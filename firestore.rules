rules_version = '2';

// Regras de segurança do Firestore — Gestão Escolar
// Publicar com:  firebase deploy --only firestore:rules
//
// Princípios:
// - Nega tudo por padrão (coleção sem match fica inacessível).
// - A proteção real está aqui, não no front-end.
// - Perfis: admin (tudo), administrativo (RH), diretora (só a própria escola).
// - Toda operação exige conta ativa (situacao == 'ativa').

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identidade e perfil ----------

    function isAutenticado() {
      return request.auth != null;
    }

    function getUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Se o usuário não tiver documento em /usuarios, o get() falha e o acesso é negado.
    function isAtiva() {
      return isAutenticado() && getUsuario().situacao == 'ativa';
    }

    function isAdmin() {
      return isAtiva() && getUsuario().perfil == 'admin';
    }

    function isAdministrativo() {
      return isAtiva() && getUsuario().perfil == 'administrativo';
    }

    function isDiretora() {
      return isAtiva() && getUsuario().perfil == 'diretora';
    }

    function minhaEscola(escolaId) {
      return getUsuario().unidadeId == escolaId;
    }

    // Só o projeto de DEMONSTRAÇÃO tem o documento config/ambiente com demo: true.
    // Ele é criado à mão no console; o app não consegue gravá-lo (ver /config).
    // No projeto real ele não existe, o get() falha e a resposta é "não".
    function ambienteDeDemonstracao() {
      return get(/databases/$(database)/documents/config/ambiente).data.demo == true;
    }

    // ---------- Validações ----------

    function texto(valor, maximo) {
      return valor is string && valor.size() <= maximo;
    }

    // Campos que a diretora pode enviar ao abrir um chamado.
    // Impede que ela crie o chamado já "Concluído", em outra escola,
    // em nome de outra pessoa, já atribuído a alguém, com data forjada
    // ou com texto gigante.
    function solicitacaoDaDiretoraValida() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'descricao', 'localDentroEscola', 'prioridade', 'observacoes',
               'escolaId', 'escolaNome', 'responsavel', 'status',
               'solicitadaPor', 'solicitadaPorNome', 'criadoEm', 'atualizadoEm'
             ])
             && d.keys().hasAll(['descricao', 'escolaId', 'status', 'solicitadaPor'])
             && d.status == 'Pendente'
             && d.responsavel == 'A definir'
             && d.criadoEm == request.time
             && d.atualizadoEm == request.time
             && texto(d.escolaNome, 200)
             && texto(d.solicitadaPorNome, 200)
             && d.solicitadaPor == request.auth.uid
             && minhaEscola(d.escolaId)
             && d.descricao is string && d.descricao.size() > 0 && d.descricao.size() <= 2000
             && texto(d.localDentroEscola, 300)
             && texto(d.observacoes, 2000)
             && d.prioridade in ['Baixa', 'Média', 'Alta', 'Urgente'];
    }

    // ---------- Coleções ----------

    // Escolas: todos os usuários ativos leem; só admin escreve.
    match /escolas/{id} {
      allow read: if isAtiva();
      allow create, update, delete: if isAdmin();
    }

    // Manutenções: a diretora abre e acompanha os chamados da própria escola.
    match /manutencoes/{id} {
      allow read: if isAdmin() ||
                     (isDiretora() && minhaEscola(resource.data.escolaId));
      allow create: if isAdmin() ||
                       (isDiretora() && solicitacaoDaDiretoraValida());
      allow update, delete: if isAdmin();
    }

    // Contas a pagar: a diretora só lê as da própria escola.
    match /contas/{id} {
      allow read: if isAdmin() ||
                     (isDiretora() && minhaEscola(resource.data.escolaId));
      allow create, update, delete: if isAdmin();
    }

    // Ciclos periódicos: a diretora só lê os da própria escola.
    match /ciclos/{id} {
      allow read: if isAdmin() ||
                     (isDiretora() && minhaEscola(resource.data.escolaId));
      allow create, update, delete: if isAdmin();
    }

    // Prestadores de serviço (nomes, telefones, documentos):
    // antes estava aberta a qualquer usuário autenticado. Agora é só da administração.
    match /prestadores/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    // Processo seletivo: administração e RH (o menu do perfil 'administrativo'
    // inclui Processo Seletivo).
    match /candidatos/{id} {
      allow read, create, update, delete: if isAdmin() || isAdministrativo();
    }

    // Banco de currículos: administração e RH.
    match /curriculos/{id} {
      allow read, create, update, delete: if isAdmin() || isAdministrativo();
    }

    // Funcionários (colaboradores das escolas): administração e RH. Tem CPF,
    // salário e afastamentos por doença (dado sensível pela LGPD): a diretora
    // não lê. Ver docs/19-funcionarios.md.
    match /funcionarios/{id} {
      allow read, create, update, delete: if isAdmin() || isAdministrativo();
    }

    // Controle de saldo das verbas: áreas (rubricas) com verba mensal e os
    // gastos lançados em cada uma. Somente administração. O período (mês
    // inicial e nº de meses) fica em config/saldo. Ver docs/20-controle-de-saldo.md.
    match /rubricas/{id} {
      allow read, create, update, delete: if isAdmin();
    }
    match /gastos/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    // Agenda: somente administração.
    match /eventos/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    // ---------- Rede de segurança ----------

    // Histórico de alterações: só se acrescenta, nunca se altera nem apaga.
    // Cada pessoa só registra em nome próprio, com a hora do servidor
    // e apenas os campos que o app grava (ver src/services/db.js).
    match /historico/{id} {
      allow read: if isAdmin();
      allow create: if isAtiva()
                    && request.resource.data.keys().hasOnly([
                         'acao', 'colecao', 'docId', 'titulo', 'antes', 'depois',
                         'porUid', 'porEmail', 'em'
                       ])
                    && request.resource.data.porUid == request.auth.uid
                    && request.resource.data.porEmail == request.auth.token.email
                    && request.resource.data.em == request.time
                    && request.resource.data.acao in ['criar', 'alterar', 'excluir', 'restaurar']
                    && texto(request.resource.data.colecao, 100)
                    && texto(request.resource.data.docId, 200)
                    && texto(request.resource.data.titulo, 200);
      allow update: if false;
      // Apagar o histórico só existe para "restaurar dados de demonstração".
      allow delete: if isAdmin() && ambienteDeDemonstracao();
    }

    // Lixeira: o que é "excluído" vem para cá antes de sair do lugar original.
    // Restaurar (apagar daqui e recriar no original) é só do admin.
    match /lixeira/{id} {
      allow read: if isAdmin() ||
                     (isAdministrativo() && resource.data.colecao in ['curriculos', 'candidatos', 'funcionarios']);
      allow create: if request.resource.data.excluidoPor == request.auth.uid
                    && (isAdmin() ||
                        (isAdministrativo() && request.resource.data.colecao in ['curriculos', 'candidatos', 'funcionarios']));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Importações de planilha: quem importou, de qual arquivo e o que foi criado,
    // para poder desfazer. Admin importa tudo; RH, currículos e funcionários. Nunca se apaga
    // (fora do ambiente de demonstração); só o status muda.
    match /importacoes/{id} {
      function podeImportar(colecao) {
        return isAdmin() || (isAdministrativo() && colecao in ['curriculos', 'funcionarios']);
      }
      allow read: if isAdmin() ||
                     (isAdministrativo() && resource.data.colecao in ['curriculos', 'funcionarios']);
      allow create: if podeImportar(request.resource.data.colecao)
                    && request.resource.data.colecao in ['escolas', 'contas', 'ciclos', 'curriculos', 'funcionarios', 'rubricas', 'gastos']
                    && request.resource.data.porUid == request.auth.uid
                    && request.resource.data.status == 'em andamento'
                    && request.resource.data.em == request.time;
      allow update: if podeImportar(resource.data.colecao)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'importados', 'desfeitaEm', 'desfeitaPor'])
                    && request.resource.data.status in ['concluida', 'incompleta', 'desfeita'];
      allow delete: if isAdmin() && ambienteDeDemonstracao();
    }

    // Alertas do painel marcados como "ciente, lembrar depois" (até uma data).
    // O id do documento é a chave do alerta (ex.: "ciclo:abc"). Só a administração usa.
    match /alertasAdiados/{chave} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(['ate', 'porUid', 'porEmail', 'em'])
                            && request.resource.data.ate is string
                            && request.resource.data.ate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                            && request.resource.data.porUid == request.auth.uid
                            && request.resource.data.em == request.time;
    }

    // Configurações do sistema (ex.: data da última cópia de segurança).
    // config/ambiente marca o projeto de demonstração e não pode ser gravado
    // pelo app, nem pelo admin: só pelo console do Firebase.
    match /config/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && id != 'ambiente';
    }

    // Usuários: cada um lê o próprio perfil; só admin cria e edita.
    // Apagar é proibido para todos (desativar em vez de excluir).
    match /usuarios/{uid} {
      allow read: if isAutenticado() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
