rules_version = '2';

// Regras de segurança do Firestore — Gestão Escolar
// Publicar com:  firebase deploy --only firestore:rules
//
// Princípios:
// - Nega tudo por padrão (coleção sem match fica inacessível).
// - A proteção real está aqui, não no front-end.
// - Cada registro pertence a um município (campo municipioId). Ninguém lê nem
//   grava o que é de outro município. Ver docs/22-acesso-por-municipio.md.
// - Perfis:
//     sede            todos os municípios (escolhe um e trabalha como a administração dele)
//     admin           administração de UM município (tudo dele)
//     administrativo  RH de um município (funcionários, currículos, processo seletivo)
//     diretora        só a própria escola
// - Toda operação exige conta ativa (situacao == 'ativa').
// - Só a sede muda um registro de município.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identidade e perfil ----------

    function isAutenticado() {
      return request.auth != null;
    }

    function getUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Se o usuário não tiver documento em /usuarios, o get() falha e o acesso é negado.
    function isAtiva() {
      return isAutenticado() && getUsuario().situacao == 'ativa';
    }

    function temPerfil(perfil) {
      return isAtiva() && getUsuario().perfil == perfil;
    }

    function isSede() {
      return temPerfil('sede');
    }

    function isAdmin() {
      return temPerfil('admin');
    }

    function isAdministrativo() {
      return temPerfil('administrativo');
    }

    function isDiretora() {
      return temPerfil('diretora');
    }

    // Município de quem está pedindo (a sede não tem).
    function meuMunicipio() {
      return getUsuario().municipioId;
    }

    function minhaEscola(escolaId) {
      return getUsuario().unidadeId == escolaId;
    }

    // ---------- Município do registro ----------
    // A sede passa sempre; a administração só no próprio município.

    // Ler ou apagar um registro existente.
    function administraAtual() {
      return isSede() || (isAdmin() && resource.data.municipioId == meuMunicipio());
    }

    // Criar um registro.
    function administraNovo() {
      return isSede() || (isAdmin() && request.resource.data.municipioId == meuMunicipio());
    }

    // Alterar: o registro precisa ser do município antes E depois (não dá para "mudar de município").
    function administraAlteracao() {
      return isSede() || (isAdmin()
                          && resource.data.municipioId == meuMunicipio()
                          && request.resource.data.municipioId == meuMunicipio());
    }

    // O mesmo, para o RH do município.
    function rhAtual() {
      return isAdministrativo() && resource.data.municipioId == meuMunicipio();
    }
    function rhNovo() {
      return isAdministrativo() && request.resource.data.municipioId == meuMunicipio();
    }
    function rhAlteracao() {
      return rhAtual() && rhNovo();
    }

    // Dados antigos (de antes da divisão por município): a sede pode apenas
    // acrescentar o município, sem mudar mais nada. Vale até para o histórico
    // e a lixeira, que de resto nunca se alteram.
    function sedeAtribuiMunicipio() {
      return isSede()
             && !('municipioId' in resource.data)
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['municipioId']);
    }

    // Configurações e alertas guardados dentro do município (municipios/{id}/...).
    function administraMunicipio(municipioId) {
      return isSede() || (isAdmin() && meuMunicipio() == municipioId);
    }

    // Só o projeto de DEMONSTRAÇÃO tem o documento config/ambiente com demo: true.
    // Ele é criado à mão no console; o app não consegue gravá-lo (ver /config).
    // No projeto real ele não existe, o get() falha e a resposta é "não".
    function ambienteDeDemonstracao() {
      return get(/databases/$(database)/documents/config/ambiente).data.demo == true;
    }

    // ---------- Validações ----------

    function texto(valor, maximo) {
      return valor is string && valor.size() <= maximo;
    }

    // Campos que a diretora pode enviar ao abrir um chamado.
    // Impede que ela crie o chamado já "Concluído", em outra escola ou outro
    // município, em nome de outra pessoa, já atribuído a alguém, com data
    // forjada ou com texto gigante.
    function solicitacaoDaDiretoraValida() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'descricao', 'localDentroEscola', 'prioridade', 'observacoes',
               'escolaId', 'escolaNome', 'responsavel', 'status',
               'solicitadaPor', 'solicitadaPorNome', 'criadoEm', 'atualizadoEm',
               'municipioId'
             ])
             && d.keys().hasAll(['descricao', 'escolaId', 'status', 'solicitadaPor', 'municipioId'])
             && d.municipioId == meuMunicipio()
             && d.status == 'Pendente'
             && d.responsavel == 'A definir'
             && d.criadoEm == request.time
             && d.atualizadoEm == request.time
             && texto(d.escolaNome, 200)
             && texto(d.solicitadaPorNome, 200)
             && d.solicitadaPor == request.auth.uid
             && minhaEscola(d.escolaId)
             && d.descricao is string && d.descricao.size() > 0 && d.descricao.size() <= 2000
             && texto(d.localDentroEscola, 300)
             && texto(d.observacoes, 2000)
             && d.prioridade in ['Baixa', 'Média', 'Alta', 'Urgente'];
    }

    // ---------- Municípios e contratos ----------

    // Municípios: a sede cadastra; cada usuário lê só o próprio (nome no topo da tela).
    match /municipios/{municipioId} {
      allow get: if isSede() || (isAtiva() && meuMunicipio() == municipioId);
      allow list, create, update, delete: if isSede();

      // Configurações do município: data da última cópia de segurança e
      // período do controle de saldo.
      match /config/{id} {
        allow read, write: if administraMunicipio(municipioId);
      }

      // Alertas do painel marcados como "ciente, lembrar depois" (até uma data).
      // O id do documento é a chave do alerta (ex.: "ciclo:abc").
      match /alertasAdiados/{chave} {
        allow read, delete: if administraMunicipio(municipioId);
        allow create, update: if administraMunicipio(municipioId)
                              && request.resource.data.keys().hasOnly(['ate', 'porUid', 'porEmail', 'em'])
                              && request.resource.data.ate is string
                              && request.resource.data.ate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                              && request.resource.data.porUid == request.auth.uid
                              && request.resource.data.em == request.time;
      }
    }

    // Contratos (termos de colaboração): a administração do município lê os
    // seus; só a sede cadastra e altera.
    match /contratos/{id} {
      allow read: if administraAtual();
      allow create, update, delete: if isSede();
    }

    // ---------- Coleções do dia a dia (todas por município) ----------

    // Escolas: os usuários do município leem (nome da escola nas telas);
    // só a administração escreve.
    match /escolas/{id} {
      allow read: if isSede() || (isAtiva() && resource.data.municipioId == meuMunicipio());
      allow create: if administraNovo();
      allow update: if administraAlteracao();
      allow delete: if administraAtual();
    }

    // Manutenções: a diretora abre e acompanha os chamados da própria escola.
    match /manutencoes/{id} {
      allow read: if administraAtual() ||
                     (isDiretora() && minhaEscola(resource.data.escolaId));
      allow create: if administraNovo() ||
                       (isDiretora() && solicitacaoDaDiretoraValida());
      allow update: if administraAlteracao();
      allow delete: if administraAtual();
    }

    // Contas a pagar: a diretora só lê as da própria escola.
    match /contas/{id} {
      allow read: if administraAtual() ||
                     (isDiretora() && minhaEscola(resource.data.escolaId));
      allow create: if administraNovo();
      allow update: if administraAlteracao();
      allow delete: if administraAtual();
    }

    // Ciclos periódicos: a diretora só lê os da própria escola.
    match /ciclos/{id} {
      allow read: if administraAtual() ||
                     (isDiretora() && minhaEscola(resource.data.escolaId));
      allow create: if administraNovo();
      allow update: if administraAlteracao();
      allow delete: if administraAtual();
    }

    // Só da administração do município: prestadores (nomes, telefones,
    // documentos), agenda e controle de saldo (áreas e gastos).
    match /prestadores/{id} {
      allow read, delete: if administraAtual();
      allow create: if administraNovo();
      allow update: if administraAlteracao();
    }
    match /eventos/{id} {
      allow read, delete: if administraAtual();
      allow create: if administraNovo();
      allow update: if administraAlteracao();
    }
    match /rubricas/{id} {
      allow read, delete: if administraAtual();
      allow create: if administraNovo();
      allow update: if administraAlteracao();
    }
    match /gastos/{id} {
      allow read, delete: if administraAtual();
      allow create: if administraNovo();
      allow update: if administraAlteracao();
    }

    // Administração e RH do município: processo seletivo, banco de currículos
    // e funcionários (este tem CPF, salário e afastamentos por doença, dado
    // sensível pela LGPD: a diretora não lê; ver docs/19-funcionarios.md).
    match /candidatos/{id} {
      allow read, delete: if administraAtual() || rhAtual();
      allow create: if administraNovo() || rhNovo();
      allow update: if administraAlteracao() || rhAlteracao();
    }
    match /curriculos/{id} {
      allow read, delete: if administraAtual() || rhAtual();
      allow create: if administraNovo() || rhNovo();
      allow update: if administraAlteracao() || rhAlteracao();
    }
    match /funcionarios/{id} {
      allow read, delete: if administraAtual() || rhAtual();
      allow create: if administraNovo() || rhNovo();
      allow update: if administraAlteracao() || rhAlteracao();
    }

    // ---------- Rede de segurança ----------

    // Histórico de alterações: só se acrescenta, nunca se altera nem apaga.
    // Cada pessoa só registra em nome próprio, no próprio município, com a
    // hora do servidor e apenas os campos que o app grava (ver src/services/db.js).
    match /historico/{id} {
      allow read: if administraAtual();
      allow create: if isAtiva()
                    && request.resource.data.keys().hasOnly([
                         'acao', 'colecao', 'docId', 'titulo', 'antes', 'depois',
                         'porUid', 'porEmail', 'em', 'municipioId'
                       ])
                    && (isSede() || request.resource.data.municipioId == meuMunicipio())
                    && request.resource.data.porUid == request.auth.uid
                    && request.resource.data.porEmail == request.auth.token.email
                    && request.resource.data.em == request.time
                    && request.resource.data.acao in ['criar', 'alterar', 'excluir', 'restaurar']
                    && texto(request.resource.data.colecao, 100)
                    && texto(request.resource.data.docId, 200)
                    && texto(request.resource.data.titulo, 200);
      allow update: if sedeAtribuiMunicipio();
      // Apagar o histórico só existe para "restaurar dados de demonstração".
      allow delete: if isSede() && ambienteDeDemonstracao();
    }

    // Lixeira: o que é "excluído" vem para cá antes de sair do lugar original.
    // Restaurar (apagar daqui e recriar no original) é da administração do município.
    match /lixeira/{id} {
      allow read: if administraAtual() ||
                     (rhAtual() && resource.data.colecao in ['curriculos', 'candidatos', 'funcionarios']);
      allow create: if request.resource.data.excluidoPor == request.auth.uid
                    && (administraNovo() ||
                        (rhNovo() && request.resource.data.colecao in ['curriculos', 'candidatos', 'funcionarios']));
      allow update: if sedeAtribuiMunicipio();
      allow delete: if administraAtual();
    }

    // Importações de planilha: quem importou, de qual arquivo e o que foi criado,
    // para poder desfazer. A administração importa tudo; o RH, currículos e
    // funcionários. Nunca se apaga (fora do ambiente de demonstração); só o status muda.
    match /importacoes/{id} {
      function podeImportar(d) {
        return isSede()
               || (isAdmin() && d.municipioId == meuMunicipio())
               || (isAdministrativo() && d.municipioId == meuMunicipio() && d.colecao in ['curriculos', 'funcionarios']);
      }
      allow read: if podeImportar(resource.data);
      allow create: if podeImportar(request.resource.data)
                    && request.resource.data.colecao in ['escolas', 'contas', 'ciclos', 'curriculos', 'funcionarios', 'rubricas', 'gastos']
                    && request.resource.data.porUid == request.auth.uid
                    && request.resource.data.status == 'em andamento'
                    && request.resource.data.em == request.time;
      allow update: if sedeAtribuiMunicipio()
                    || (podeImportar(resource.data)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'importados', 'desfeitaEm', 'desfeitaPor'])
                        && request.resource.data.status in ['concluida', 'incompleta', 'desfeita']);
      allow delete: if isSede() && ambienteDeDemonstracao();
    }

    // ---------- Antigos (antes da divisão por município) ----------
    // config/ambiente marca o projeto de demonstração e não pode ser gravado
    // pelo app, nem pela sede: só pelo console do Firebase. Os demais
    // documentos de config e os alertas adiados antigos só a sede lê e apaga,
    // ao organizar os dados antigos.
    match /config/{id} {
      allow read: if isSede();
      allow write: if isSede() && id != 'ambiente';
    }
    match /alertasAdiados/{chave} {
      allow read, delete: if isSede();
    }

    // ---------- Usuários ----------
    // Cada um lê o próprio perfil. A sede cria e edita qualquer usuário. A
    // administração do município cria e edita só diretoras e RH do próprio
    // município (não cria outro administrador, não promove ninguém e não
    // passa ninguém para outro município). Apagar é proibido para todos
    // (desativar em vez de excluir).
    match /usuarios/{uid} {
      function equipeDoMeuMunicipio(d) {
        return d.municipioId == meuMunicipio() && d.perfil in ['diretora', 'administrativo'];
      }
      allow read: if isAutenticado() && (request.auth.uid == uid || isSede()
                     || (isAdmin() && resource.data.municipioId == meuMunicipio()));
      allow create: if isSede() || (isAdmin() && equipeDoMeuMunicipio(request.resource.data));
      allow update: if isSede() || (isAdmin()
                                    && equipeDoMeuMunicipio(resource.data)
                                    && equipeDoMeuMunicipio(request.resource.data));
      allow delete: if false;
    }
  }
}
