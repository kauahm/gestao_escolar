# Copie este arquivo para .env e preencha com os dados do seu projeto Firebase.
# O .env NÃO vai para o Git (veja .gitignore).
#
# Estes valores são a configuração pública do Firebase Web: eles são entregues
# ao navegador de qualquer visitante. A proteção real dos dados está nas
# regras do Firestore (firestore.rules) e no App Check, não em esconder isto.
# Ainda assim, mantenha-os fora do repositório e restrinja a chave de API por
# domínio no Google Cloud.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
