# Ambiente de DEMONSTRAÇÃO (segundo projeto Firebase, só com dados fictícios).
# Copie este arquivo para .env.demo e preencha com os dados do projeto de
# demonstração. O .env.demo NÃO vai para o Git (veja .gitignore).
# Passo a passo: docs/13-ambiente-de-demonstracao.md
#
# IMPORTANTE: preencha TODAS as linhas. O que ficar em branco ou faltar é
# completado com o .env do sistema real; nesse caso o app mostra um aviso
# vermelho e o modo demonstração não liga.
#
# Usado por:  npm run dev:demo   e   npm run build:demo

VITE_AMBIENTE=demo

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
